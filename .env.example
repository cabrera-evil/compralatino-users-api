# Node Environment
NODE_ENV=development # development | production | test | staging

# Frontend URL and Port
FRONTEND_URL=http://localhost:3000
PORT=3000

# TCP Microservice Configuration
TCP_ENABLED=false
TCP_HOST=0.0.0.0
TCP_PORT=4010
TCP_RETRY_ATTEMPTS=5
TCP_RETRY_DELAY=2000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-jwt-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
API_KEYS=your-long-api-keys-comma-separated # comma-separated; also used by RPC fallback auth

# Encryption Configuration
ENCRYPTION_ENABLED=false # Set to true to enable request/response encryption
ENCRYPTION_PASSPHRASE=your-strong-encryption-passphrase-min-32-chars
DECRYPTION_PASSPHRASE=your-strong-decryption-passphrase-min-32-chars

# Password Hashing Configuration
SALT_ROUNDS=10

# Cache Store Configuration
CACHE_ENABLED=true # true | false
CACHE_STORE=memory # memory | redis
CACHE_TTL=3600

# Queue Configuration
QUEUE_ENABLED=false # true | false
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF=2000
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=3000

# Rate Limiting Configuration
THROTTLE_ENABLED=true # true | false
THROTTLE_STORAGE=memory # memory | redis (for distributed rate limiting)

# Short-term throttling (per second)
THROTTLE_SHORT_TTL=1000 # 1 second in milliseconds
THROTTLE_SHORT_LIMIT=10 # 10 requests per second

# Medium-term throttling (per minute)
THROTTLE_MEDIUM_TTL=60000 # 1 minute in milliseconds
THROTTLE_MEDIUM_LIMIT=100 # 100 requests per minute

# Long-term throttling (per hour)
THROTTLE_LONG_TTL=3600000 # 1 hour in milliseconds
THROTTLE_LONG_LIMIT=1000 # 1000 requests per hour

# Proxy Configuration (for apps behind load balancers)
THROTTLE_TRUST_PROXY=false # Set to true when behind proxy
THROTTLE_PROXY_DEPTH=1 # Number of proxies in chain

# Database URL
DATABASE_URL=postgresql://username:password@localhost:5432/yourdatabase

# Docker Compose Postgres Configuration
POSTGRES_PASSWORD=admin

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=your-redis-username
REDIS_PASSWORD=your-redis-password
REDIS_TLS=true
REDIS_CONNECT_TIMEOUT=10000

# Admin Configuration (optional)
ADMIN_USERNAME=admin
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_IGNORE_TLS=false
SMTP_SECURE=false
SMTP_USERNAME=email@example.com
SMTP_PASSWORD=email-password
SMTP_DEFAULT_FROM=no-reply@example.com
SMTP_DEFAULT_REPLY_TO=support@example.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_PATH=/auth/google/callback

# Puppeteer Executable Path (optional)
PUPPETEER_EXECUTABLE_PATH=/path/to/puppeteer
