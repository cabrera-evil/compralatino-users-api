	<td style="padding: 28px 40px 32px; text-align: center; border-top: 1px solid #2a2a33;">
		{{#if footerNote}}
		<div style="margin: 0 0 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #71717a;">{{footerNote}}</div>
		{{/if}}
		<div style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; color: #71717a;">&copy; {{year}} {{#if companyName}}{{companyName}}{{else}}Application{{/if}}. All rights reserved.</div>
	</td>
</tr>
